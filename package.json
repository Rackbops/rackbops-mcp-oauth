{
  "name": "@rackbops/mcp-oauth",
  "version": "0.1.5",
  "description": "OAuth 2.1 authorization server for remote MCP servers (DCR, PKCE S256, consent behind a usr sign-in, token, refresh rotation, SQLite grants store), plus the shared MCP server pieces: tool registry and dispatch, bearer gate, Host guard, request trace, usr role checks and delegation tokens.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rackbops/rackbops-mcp-oauth.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./hono": {
      "types": "./dist/hono/index.d.ts",
      "default": "./dist/hono/index.js"
    },
    "./usr": {
      "types": "./dist/usr/index.d.ts",
      "default": "./dist/usr/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome check . && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": ">=2.3.1 <3",
    "hono": "^4.13.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/node": "^26.6.3",
    "hono": "^4.13.19",
    "typescript": "^7.0.0",
    "vitest": "^5.0.2"
  }
}
